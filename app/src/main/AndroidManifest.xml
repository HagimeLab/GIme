<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 判分震动：没有这条权限 navigator.vibrate() 在 WebView 里静默失效 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 检查更新要连 GitHub，下载完要拉起系统安装页 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="GIme"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 微信里长按文件 →「用其他应用打开」→ 刷题 -->
            <intent-filter android:label="导入题库">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="text/markdown" />
                <!-- 不再声明 application/msword：.doc 是 OLE 复合文档，我们真读不了，
                     把 GIme 放进 .doc 的「打开方式」里只会让用户白点一次再吃一个报错。
                     octet-stream 保留：不少文件管理器把 PDF 也报成它，
                     进来后按文件头嗅探，认得出来就照常导，认不出才拒绝。 -->
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <intent-filter android:label="导入题库">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>
    </application>

</manifest>
