<?xml version="1.0" encoding="utf-8"?>
<!--
  网络策略：默认只允许 HTTPS。

  为什么要单独写这个文件：Android 9（API 28）起系统默认禁止明文 HTTP，
  而「我的 → 大肥鱼」允许用户自填接口地址。如果用户填的是本机反代
  （http://127.0.0.1:9701/v1 之类），不开这个口子就会直接失败，
  且错误信息只有一句 ECONNREFUSED / cleartext not permitted，
  用户根本不知道是系统拦的。

  但也不能全局开明文（android:usesCleartextTraffic="true"）——那等于允许
  任何 HTTP 地址，包括公网中间人。所以这里只对回环地址放行：
  流量本来就在本机里，被中间人劫持的风险与危害都有限。
  公网地址仍然必须 https。

  局域网自建反代怎么办（重要）：
  Android 的 <domain> 只做**字面主机名匹配**，不支持 CIDR / 网段通配。
  写 <domain>192.168.0.0</domain> 不会放行 192.168.1.50 这样的地址。
  （此前配置里写过 192.168.0.0 / 10.0.0.0 两条，属于无效条目，已删除——
    它们只对字面那两个 IP 生效，与注释承诺的语义不符。）

  因此局域网反代请走这两种方式之一：
    ① adb reverse tcp:9701 tcp:9701，把设备上的 127.0.0.1:9701 转发到电脑，
       然后在 App 里填 http://127.0.0.1:9701/v1（走上面已放行的回环）；
    ② 直接用 https 地址。
-->
<network-security-config>
    <!-- 默认：禁止明文 -->
    <base-config cleartextTrafficPermitted="false" />

    <domain-config cleartextTrafficPermitted="true">
        <!-- 本机回环：adb reverse 转出去的 mock / 本地反代 -->
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">::1</domain>
    </domain-config>
</network-security-config>
